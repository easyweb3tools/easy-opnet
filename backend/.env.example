# OPNet Network: regtest | testnet | mainnet
OPNET_NETWORK=testnet

# Cloudflare D1 database id (used by deploy script to bind DB)
D1_DATABASE_ID=

# RPC URLs (defaults provided for regtest)
OPNET_RPC_URL_REGTEST=https://regtest.opnet.org
OPNET_RPC_URL_TESTNET=https://testnet.opnet.org
OPNET_RPC_URL_MAINNET=https://mainnet.opnet.org

# Contract Addresses (deploy and fill these in)
MARKETPLACE_CONTRACT_ADDRESS=
NFT_HUB_CONTRACT_ADDRESS=

# Wallet (BIP39 mnemonic for the backend agent wallet)
WALLET_MNEMONIC=

# Pinata IPFS (for NFT metadata uploads)
PINATA_JWT=

# Server
PORT=3001

# Dev-only listing seed fallback:
# - regtest default: enabled
# - testnet/mainnet default: disabled
# Set to 1 to force-enable, 0 to force-disable.
ALLOW_DEV_SEED_LISTINGS=
