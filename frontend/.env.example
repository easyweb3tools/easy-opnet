# Cloudflare D1 Database ID (from `wrangler d1 list`)
D1_DATABASE_ID=

# Backend API URL used by frontend API route proxy (/api/* -> backend)
# Example: http://localhost:3001 (dev) or https://agentvault-backend.<subdomain>.workers.dev (prod)
BACKEND_BASE_URL=

# Emergency override: allow mock API fallback even in production runtime (0/1)
ALLOW_MOCK_API=0

# Optional client-side direct API base (usually leave empty to use /api proxy)
NEXT_PUBLIC_BACKEND_URL=
NEXT_PUBLIC_USE_DIRECT_BACKEND=0
