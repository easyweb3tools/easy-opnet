{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@btc-vision/btc-runtime/runtime": ["./node_modules/@btc-vision/btc-runtime/runtime"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
